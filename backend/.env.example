# Keep real secrets in backend/.env, never commit them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
TAVILY_API_KEY=
# Comma-separated browser origins allowed to call this API. Replace the
# placeholder with the final Vercel domain during deployment.
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app
# Keep benchmark metrics private. Set true only for a local project demo.
EVALUATION_DASHBOARD_ENABLED=false
# Keep benchmark metrics private. Set true only for a local project demo.
EVALUATION_DASHBOARD_ENABLED=false
